# Copia este archivo como .env.local y rellena los valores reales.
# Nunca comitees .env.local ni ningún archivo con credenciales reales.

# ─── Base de datos (Supabase) ─────────────────────────────────────────────────
# En desarrollo, estas apuntan al stack LOCAL (supabase start, puertos 573xx).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Proyecto remoto: solo lo usan acciones explícitas (seed con --remote, migraciones).
# DATABASE_URL es la connection string de Postgres del remoto (para migraciones).
DATABASE_URL=
SUPABASE_REMOTE_URL=
SUPABASE_REMOTE_ANON_KEY=
SUPABASE_REMOTE_SERVICE_ROLE_KEY=

# ─── Autenticación (Clerk, provider de GitHub) ────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ─── GitHub App (sincronización de repos y webhooks) ──────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ─── Jobs en background (Inngest o Trigger.dev; borrar el que no se use) ──────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── Cache / rate limiting (Upstash Redis) ────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Configuración de la app ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Límite de repos importables por perfil (v1)
REPO_SELECTION_LIMIT=5

# ─── MCP (servidores para el agente de código) ────────────────────────────────
# Los servidores actuales (supabase, vercel) autentican por OAuth vía /mcp: no necesitan clave.
# Si algún día un servidor MCP pide credencial, va referenciada en .mcp.json como ${VARIABLE}
# y el valor real vive aquí (en .env.local).
