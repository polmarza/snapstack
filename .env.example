# Copia este archivo como .env.local y rellena los valores reales.
# Nunca comitees .env.local ni ningún archivo con credenciales reales.

# ─── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=

# ─── Autenticación ────────────────────────────────────────────────────────────
AUTH_SECRET=

# ─── APIs externas ────────────────────────────────────────────────────────────
# NOMBRE_SERVICIO_API_KEY=

# ─── Configuración de la app ──────────────────────────────────────────────────
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── MCP (servidores para el agente de código) ────────────────────────────────
# Credenciales que consumen los servidores declarados en .mcp.json.
# En .mcp.json van referenciadas como ${VARIABLE}; el valor real vive aquí (en .env.local).
# Añade una línea por cada servidor MCP que necesite clave. Los que usan OAuth no llevan nada.
# SUPABASE_ACCESS_TOKEN=
# RESEND_API_KEY=
