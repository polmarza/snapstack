# Copia este archivo como .env.local y rellena los valores reales.
# Nunca comitees .env.local ni ningún archivo con credenciales reales.

# ─── Base de datos (Supabase) ─────────────────────────────────────────────────
# En desarrollo, estas apuntan al stack LOCAL (supabase start, puertos 573xx).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Proyecto remoto: solo lo usan acciones explícitas (seed con --remote, migraciones).
# DATABASE_URL es la connection string de Postgres del remoto (para migraciones).
DATABASE_URL=
SUPABASE_REMOTE_URL=
SUPABASE_REMOTE_ANON_KEY=
SUPABASE_REMOTE_SERVICE_ROLE_KEY=

# ─── Autenticación (Clerk, provider de GitHub) ────────────────────────────────
# Aquí van SIEMPRE las claves de la instancia de DESARROLLO (pk_test_/sk_test_).
#
# Las de producción (pk_live_/sk_live_) NO se ponen aquí: sólo funcionan desde el
# dominio de producción. En localhost, Clerk las rechaza con "Production Keys are
# only allowed for domain ...". Su sitio es el panel de Vercel, en el entorno
# Production; para los despliegues de Preview se usan las de desarrollo.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ─── GitHub App (sincronización de repos y webhooks) ──────────────────────────
# Firma HMAC de los webhooks (obligatoria). El APP_ID y la private key NO se
# usan: los webhooks van con el payload firmado y las acciones de usuario con
# tokens de usuario — si algún día hay auth server-to-server, volverán.
GITHUB_WEBHOOK_SECRET=

# Opcional, solo para los scripts manuales (pnpm seed:trending, pnpm
# backfill:readmes): un fine-grained PAT SIN permisos (lectura pública) sube su
# rate limit de 60/h a 5000/h. La app no lo usa — los visitantes nunca tocan la
# API de GitHub, y los imports van con el token del propio usuario.
GITHUB_TOKEN=

# ─── Jobs en background (Inngest o Trigger.dev; borrar el que no se use) ──────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── Cache / rate limiting (Upstash Redis) ────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Configuración de la app ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Límite de repos importables por perfil (v1)
REPO_SELECTION_LIMIT=5

# ─── MCP (servidores para el agente de código) ────────────────────────────────
# Los servidores actuales (supabase, vercel) autentican por OAuth vía /mcp: no necesitan clave.
# Si algún día un servidor MCP pide credencial, va referenciada en .mcp.json como ${VARIABLE}
# y el valor real vive aquí (en .env.local).

# Estrella real (C-07) — OAuth de la GitHub App. Sin estas tres, la estrella
# queda como contador pasivo (interruptor de la feature). Ver docs/features/estrella-real.md.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# openssl rand -hex 32 — cifra los tokens de usuario en la base.
GITHUB_TOKEN_ENCRYPTION_KEY=

# Slug público de la GitHub App (github.com/apps/<slug>) para el aviso de
# instalación (C-08). Sin él, el aviso no se muestra.
NEXT_PUBLIC_GITHUB_APP_SLUG=
